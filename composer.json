{
    "name": "omnitrix/core",
    "description": "Omnitrix: an asynchronous PHP framework for HTTP APIs on OpenSwoole (framework and runtime engine).",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "omnitrix",
        "framework",
        "api",
        "rest",
        "async",
        "coroutine",
        "openswoole",
        "high-performance"
    ],
    "authors": [
        {
            "name": "Ajmal Alkhaledi",
            "email": "ajmalalkhaledi@gmail.com",
            "role": "Maintainer"
        }
    ],
    "require": {
        "php": ">=8.3",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-openswoole": ">=26.2.0",
        "ext-pdo": "*",
        "ext-redis": "*",
        "nikic/fast-route": "^1.3",
        "psr/container": "^2.0",
        "psr/log": "^3.0",
        "symfony/console": "^7.4"
    },
    "require-dev": {
        "ext-pdo_mysql": "*",
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpstan/phpstan": "^2.3",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpunit/phpunit": "^12.5"
    },
    "suggest": {
        "ext-pdo_mysql": "Database support for MySQL/MariaDB (mysqlnd builds only)",
        "phpunit/phpunit": "Run application tests inside a coroutine with vendor/bin/omnitrix-phpunit"
    },
    "autoload": {
        "psr-4": {
            "Omnitrix\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Omnitrix\\Core\\Tests\\": "tests/Core/",
            "Omnitrix\\Tests\\": "tests/Framework/"
        }
    },
    "bin": [
        "bin/omnitrix-phpunit"
    ],
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true,
        "allow-plugins": false
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
        "lint": "php-cs-fixer check --diff",
        "lint:fix": "php-cs-fixer fix",
        "stan": "phpstan analyse --memory-limit=1G",
        "test:unit": "bin/omnitrix-phpunit --testsuite unit",
        "test:integration": "bin/omnitrix-phpunit --testsuite integration",
        "test": "bin/omnitrix-phpunit --testsuite unit,integration",
        "check": [
            "@composer validate --strict",
            "@lint",
            "@stan",
            "@test"
        ]
    }
}
