{
    "name": "omnitrix/core",
    "description": "Omnitrix Core: the coroutine runtime, I/O engine, pools and infrastructure that power the Omnitrix framework.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "omnitrix",
        "openswoole",
        "coroutine",
        "async",
        "connection-pool",
        "runtime"
    ],
    "authors": [
        {
            "name": "Ajmal Alkhaledi",
            "email": "ajmalalkhaledi@gmail.com",
            "role": "Maintainer"
        }
    ],
    "require": {
        "php": ">=8.3",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-openswoole": ">=26.2.0",
        "ext-pdo": "*",
        "psr/container": "^2.0",
        "psr/log": "^3.0"
    },
    "require-dev": {
        "ext-pdo_mysql": "*",
        "ext-redis": "*",
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpstan/phpstan": "^2.3",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpunit/phpunit": "^12.5"
    },
    "suggest": {
        "ext-pdo_mysql": "Required by the MySQL/MariaDB driver (mysqlnd builds only)",
        "ext-redis": "Required by the Redis client, cache store and queue (phpredis >= 6.3)"
    },
    "autoload": {
        "psr-4": {
            "Omnitrix\\Core\\": "src/Core/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Omnitrix\\Core\\Tests\\": "tests/Core/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true,
        "allow-plugins": false
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
        "lint": "php-cs-fixer check --diff",
        "lint:fix": "php-cs-fixer fix",
        "stan": "phpstan analyse --memory-limit=1G",
        "test:unit": "bin/co-phpunit --testsuite unit",
        "test:integration": "bin/co-phpunit --testsuite integration",
        "test": "bin/co-phpunit --testsuite unit,integration",
        "check": [
            "@composer validate --strict",
            "@lint",
            "@stan",
            "@test"
        ]
    }
}
