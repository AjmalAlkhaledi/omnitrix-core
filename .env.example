# Connection settings for the integration test suite. The defaults match bin/services,
# which starts MariaDB and Redis locally as unprivileged processes. Export the variables
# you need to change (for example in CI) before running the tests.
OMNITRIX_TEST_DB_HOST=127.0.0.1
OMNITRIX_TEST_DB_PORT=33306
OMNITRIX_TEST_DB_NAME=omnitrix_test
OMNITRIX_TEST_DB_USER=root
OMNITRIX_TEST_DB_PASS=
OMNITRIX_TEST_REDIS_HOST=127.0.0.1
OMNITRIX_TEST_REDIS_PORT=63790
OMNITRIX_TEST_UPSTREAM_PORT=18080
