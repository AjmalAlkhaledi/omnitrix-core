# Dependencies (libraries do not commit a lock file)
/vendor/
/composer.lock

# Local runtime data: test services, logs, generated TLS certificates
/var/
*.log

# Environment and secrets
/.env
/.env.*
!/.env.example
*.pem
*.key
*.crt

# Local overrides of the distributed tool configuration
/phpunit.xml
/phpstan.neon
/.php-cs-fixer.php

# Benchmark binaries and results
/benchmarks/results/
/benchmarks/go-ref/go-ref
/benchmarks/upstream/upstream
__pycache__/
*.py[cod]

# Tool caches and reports
/.phpunit.cache/
/.phpunit.result.cache
/.php-cs-fixer.cache
/build/
/coverage/

# Editors and operating systems
/.idea/
/.vscode/
/.fleet/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
